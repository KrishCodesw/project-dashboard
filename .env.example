# Environment Variables -- Copy to .env and fill in values

# Database
DATABASE_URL="mysql://username:password@localhost:3306/academic_dashboard"

# CoE JWT (shared cookie verification)
COE_JWT_SECRET="set-coe-jwt-secret"

# Object Storage (MinIO / S3-compatible)
S3_BUCKET_NAME="your-bucket-name"
MINIO_ENDPOINT="http://127.0.0.1:9000"
MINIO_REGION="us-east-1"
MINIO_ACCESS_KEY="your-minio-access-key"
MINIO_SECRET_KEY="your-minio-secret-key"
# If endpoint is set, path-style is recommended for MinIO.
S3_FORCE_PATH_STYLE="true"
# Optional if MINIO_ENDPOINT has no scheme.
MINIO_USE_SSL="false"

# SMTP (Email)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
# Preferred for Gmail: OAuth2 using refresh token
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_REFRESH_TOKEN="your-google-refresh-token"
SMTP_FROM="your-email@gmail.com"
EMAIL_QUEUE_CRON_SECRET="<strong-random-secret>"

# Internal sync: shared secret with COE Main for user sync and lookup endpoints
SYNC_SECRET="<same-secret-as-coe-main-SYNC_SECRET>"

# COE Main URL (used by fetchUserFromCOE to look up users not yet in local DB)
COE_MAIN_URL="https://tcetcercd.in"

# Principal Dashboard — comma-separated email addresses authorized to view
# institution-wide analytics. These users do NOT gain any admin privileges.
PRINCIPAL_EMAILS=""

# Support Center (Chatwoot)
SUPPORT_ENABLED="false"
CHATWOOT_API_URL="http://chatwoot:3000/api/v1"
CHATWOOT_ACCOUNT_ID="1"
CHATWOOT_API_TOKEN="<chatwoot-api-token>"
CHATWOOT_WEBHOOK_SECRET="<chatwoot-webhook-secret>"
CHATWOOT_INBOX_ID=1