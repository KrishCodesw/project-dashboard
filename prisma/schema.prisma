generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  TEACHER
  STUDENT
}

enum ProjectStatus {
  DRAFT
  ACTIVE
  UNDER_REVIEW
  COMPLETED
  ARCHIVED
}

enum MemberRole {
  LEAD
  MEMBER
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
  BLOCKED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ReviewStatus {
  SCHEDULED
  COMPLETED
  MISSED
  RESCHEDULED
}

enum FileCategory {
  REPORT
  PRESENTATION
  CODE
  DATASET
  OTHER
}

enum NotificationType {
  TASK_ASSIGNED
  DEADLINE_APPROACHING
  REVIEW_SCHEDULED
  FEEDBACK_GIVEN
  PROJECT_UPDATED
  MILESTONE_DUE
  PROJECT_SUBMITTED
  FEEDBACK_ADDED
  CHANGES_REQUESTED
  PROJECT_APPROVED
  PROJECT_PUBLISHED
}

enum ShowcaseProjectStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  CHANGES_REQUESTED
  RESUBMITTED
  APPROVED
  PUBLISHED
  REJECTED
}

enum ShowcaseProjectDomain {
  AI
  WEB
  IOT
  DATA_SCIENCE
  MOBILE
  CLOUD
  CYBERSECURITY
  OTHER
}

enum ShowcaseAssetKind {
  DOCUMENTATION
  SCREENSHOT
  OTHER
}

enum EmailQueueStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

enum DeliveryStatus {
  BOUNCED
}

enum ProjectType {
  INHOUSE
  OUTHOUSE
  INDUSTRY_SPONSORED
}

enum ProjectCategory {
  APPLICATION
  MULTIDISCIPLINARY
  RESEARCH
  CORE
}

enum ProjectApplication {
  SOCIETY_USE
  GOVERNMENT_USE
  INSTITUTE_USE
  INDUSTRY_USE
}

enum ProjectOutcome {
  PUBLICATION
  PATENT
  PRODUCT
  COPYRIGHT
}

enum SDG {
  GOAL_1_NO_POVERTY
  GOAL_2_ZERO_HUNGER
  GOAL_3_GOOD_HEALTH
  GOAL_4_QUALITY_EDUCATION
  GOAL_5_GENDER_EQUALITY
  GOAL_6_CLEAN_WATER
  GOAL_7_CLEAN_ENERGY
  GOAL_8_DECENT_WORK
  GOAL_9_INDUSTRY_INNOVATION
  GOAL_10_REDUCED_INEQUALITIES
  GOAL_11_SUSTAINABLE_CITIES
  GOAL_12_RESPONSIBLE_CONSUMPTION
  GOAL_13_CLIMATE_ACTION
  GOAL_14_LIFE_BELOW_WATER
  GOAL_15_LIFE_ON_LAND
  GOAL_16_PEACE_AND_JUSTICE
  GOAL_17_PARTNERSHIPS
}

enum PublicationType {
  PAPER
  PATENT
  BOOK_CHAPTER
  COPYRIGHT
  REVIEW
}

enum PublicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum IndexingType {
  SCOPUS
  SCI
  WEB_OF_SCIENCE
  UGC_CARE
  NONE
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role
  avatarUrl    String?
  department   String?
  rollNumber   String?
  uid          String?
  isHod        Boolean  @default(false)
  isGuide      Boolean  @default(false)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  lastVisitedAt DateTime?

  // Relations
  managedProjects       Project[]                  @relation("TeacherProjects")
  memberships           ProjectMember[]
  assignedTasks         Task[]                     @relation("TaskAssignee")
  reviews               Review[]                   @relation("ReviewReviewer")
  uploadedFiles         ProjectFile[]
  comments              Comment[]
  notifications         Notification[]
  showcaseProjects      ShowcaseProject[]
  showcaseFeedback      ReviewFeedback[]
  pendingProjectInvites PendingProjectAssignment[] @relation("PendingAssignmentInviter")
  publicationsEntered   Publication[]              @relation("PublicationEnteredBy")
  publicationsApproved  Publication[]              @relation("PublicationApprovedBy")
  departmentConfigs     DepartmentConfiguration[]
  guideInvitationsSent  FacultyGuideInvitation[]
  departmentGuides      DepartmentGuide[]              @relation("DepartmentGuideMember")
  departmentGuidesAdded DepartmentGuide[]              @relation("DepartmentGuideAddedBy")

  @@index([uid])
  @@index([role, uid])
  @@map("users")
  @@index([role, isActive])
}

model Project {
  id                   String              @id @default(cuid())
  title                String
  description          String              @db.Text
  domain               String
  department           String?
  status               ProjectStatus       @default(DRAFT)
  startDate            DateTime
  endDate              DateTime
  maxGroupSize         Int                 @default(4)
  completionPercentage Float               @default(0)
  hasPendingEdit       Boolean             @default(false)
  pendingEditData      Json?
  teacherId            String
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  type                 ProjectType?
  category             ProjectCategory?
  application          ProjectApplication?
  outcome              ProjectOutcome?
  poMapping            String? // Keeping as String for simple comma-separated entry like "PO1, PO2"
  psoMapping           String? // e.g., "1, 2"
  sdg                  SDG?
  groupNo              String?
  isRblProject         Boolean             @default(false)
  isPinned             Boolean             @default(false)

  // Relations
  teacher            User                       @relation("TeacherProjects", fields: [teacherId], references: [id])
  members            ProjectMember[]
  tasks              Task[]
  milestones         Milestone[]
  reviews            Review[]
  files              ProjectFile[]
  tags               ProjectTag[]
  pendingAssignments PendingProjectAssignment[]
  publications       Publication[]

  @@index([teacherId])
  @@index([status])
  @@index([teacherId, status])
  @@index([title])
  @@index([department, status])
  @@map("projects")
}

model PendingProjectAssignment {
  id          String     @id @default(cuid())
  projectId   String
  email       String
  name        String?
  memberRole  MemberRole @default(MEMBER)
  invitedById String
  status      String     @default("PENDING")
  deliveryStatus      DeliveryStatus?
  bounceDiagnosticRaw String?  @db.Text
  bounceReason        String?
  lastBounceAt        DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  invitedBy User    @relation("PendingAssignmentInviter", fields: [invitedById], references: [id])

  @@unique([projectId, email])
  @@index([email])
  @@index([status])
  @@index([projectId, status])
  @@map("pending_project_assignments")
}

model EmailQueue {
  id        String           @id @default(cuid())
  to        String
  subject   String
  body      String           @db.LongText
  status    EmailQueueStatus @default(PENDING)
  attempts  Int              @default(0)
  errorLog  String?          @db.Text
  messageId String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([status, createdAt])
  @@index([to])
  @@map("email_queue")
}

model ProjectMember {
  id        String     @id @default(cuid())
  projectId String
  studentId String
  role      MemberRole @default(MEMBER)
  joinedAt  DateTime   @default(now())
  isPinned  Boolean    @default(false)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  student User    @relation(fields: [studentId], references: [id])

  @@unique([projectId, studentId])
  @@index([studentId])
  @@map("project_members")
}

model Task {
  id           String       @id @default(cuid())
  projectId    String
  title        String
  description  String?      @db.Text
  assignedToId String?
  status       TaskStatus   @default(TODO)
  priority     TaskPriority @default(MEDIUM)
  dueDate      DateTime?
  completedAt  DateTime?
  orderIndex   Int          @default(0)
  parentTaskId String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  // Relations
  project    Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignedTo User?         @relation("TaskAssignee", fields: [assignedToId], references: [id])
  parentTask Task?         @relation("SubTasks", fields: [parentTaskId], references: [id])
  subtasks   Task[]        @relation("SubTasks")
  comments   Comment[]
  files      ProjectFile[] @relation("TaskFiles")

  @@index([projectId])
  @@index([assignedToId])
  @@index([status])
  @@map("tasks")
}

model Milestone {
  id          String    @id @default(cuid())
  projectId   String
  title       String
  description String?   @db.Text
  dueDate     DateTime
  isCompleted Boolean   @default(false)
  completedAt DateTime?
  weight      Int       @default(10)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("milestones")
}

model Review {
  id           String       @id @default(cuid())
  projectId    String
  reviewerId   String
  reviewType   String
  scheduledAt  DateTime
  conductedAt  DateTime?
  status       ReviewStatus @default(SCHEDULED)
  overallScore Float?
  feedback     String?      @db.Text
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  project        Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  reviewer       User             @relation("ReviewReviewer", fields: [reviewerId], references: [id])
  criteriaScores ReviewCriteria[]

  @@index([projectId])
  @@index([reviewerId])
  @@map("reviews")
}

model ReviewCriteria {
  id           String  @id @default(cuid())
  reviewId     String
  criteriaName String
  score        Float
  remarks      String? @db.Text

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([reviewId])
  @@map("review_criteria")
}

model ProjectFile {
  id         String       @id @default(cuid())
  projectId  String
  taskId     String?
  uploadedBy String
  fileName   String
  fileType   String
  fileSize   Int
  s3Key      String
  s3Url      String       @db.Text
  category   FileCategory @default(OTHER)
  uploadedAt DateTime     @default(now())

  project  Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task     Task?   @relation("TaskFiles", fields: [taskId], references: [id])
  uploader User    @relation(fields: [uploadedBy], references: [id])

  @@index([projectId])
  @@index([taskId])
  @@map("project_files")
}

model Comment {
  id        String   @id @default(cuid())
  taskId    String
  authorId  String
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id])

  @@index([taskId])
  @@map("comments")
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String           @db.Text
  isRead    Boolean          @default(false)
  link      String?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@map("notifications")
}

model Tag {
  id       String       @id @default(cuid())
  name     String       @unique
  color    String
  projects ProjectTag[]

  @@map("tags")
}

model ProjectTag {
  projectId String
  tagId     String

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([projectId, tagId])
  @@map("project_tags")
}

model ShowcaseProject {
  id                      String                @id @default(cuid())
  title                   String
  shortDescription        String                @default("") @db.VarChar(500)
  fullDescription         String                @db.Text
  problemStatement        String?               @db.Text
  objectives              String?               @db.Text
  methodology             String?               @db.Text
  architectureDescription String?               @db.Text
  databaseUsed            String?
  githubUrl               String?               @db.VarChar(500)
  liveDemoUrl             String?               @db.VarChar(500)
  documentationUrl        String?               @db.VarChar(500)
  projectDomain           ShowcaseProjectDomain @default(OTHER)
  mentorName              String?
  mentorEmail             String?
  keyFeatures             Json
  techStack               Json
  apiIntegrations         Json
  categories              Json
  ownerId                 String
  status                  ShowcaseProjectStatus @default(DRAFT)
  currentVersion          Int                   @default(1)
  isPublic                Boolean               @default(false)
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt

  owner       User                 @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  versions    ProjectVersion[]
  feedbacks   ReviewFeedback[]
  assets      ProjectAsset[]
  teamMembers ShowcaseTeamMember[]

  @@index([ownerId])
  @@index([status])
  @@index([isPublic])
  @@index([projectDomain])
  @@map("showcase_projects")
}

model ProjectVersion {
  id          String   @id @default(cuid())
  projectId   String
  version     Int
  snapshot    Json
  submittedAt DateTime @default(now())

  project  ShowcaseProject  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  feedback ReviewFeedback[]
  assets   ProjectAsset[]

  @@unique([projectId, version])
  @@index([projectId])
  @@map("project_versions")
}

model ReviewFeedback {
  id         String   @id @default(cuid())
  projectId  String
  versionId  String
  authorId   String
  message    String   @db.Text
  isResolved Boolean  @default(false)
  createdAt  DateTime @default(now())

  project ShowcaseProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  version ProjectVersion  @relation(fields: [versionId], references: [id], onDelete: Cascade)
  author  User            @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([versionId])
  @@index([authorId])
  @@map("review_feedback")
}

model ProjectAsset {
  id        String            @id @default(cuid())
  projectId String
  versionId String?
  kind      ShowcaseAssetKind @default(OTHER)
  fileName  String?
  fileUrl   String            @db.Text
  fileType  String

  project ShowcaseProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  version ProjectVersion? @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([versionId])
  @@index([kind])
  @@map("project_assets")
}

model ShowcaseTeamMember {
  id         String   @id @default(cuid())
  projectId  String
  name       String
  role       String
  orderIndex Int      @default(0)
  createdAt  DateTime @default(now())

  project ShowcaseProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("showcase_team_members")
}

model Publication {
  id               String            @id @default(cuid())
  projectId        String
  title            String
  authors          String // comma-separated list
  publicationType  PublicationType
  subType          String? // e.g., "Indexed", "Non-Indexed", "Filed", "Published", "Granted"
  publicationDate  DateTime
  status           PublicationStatus @default(PENDING)
  uniqueIdentifier String?           @unique // DOI, ISBN, Registration No., App Number
  indexingType     IndexingType      @default(NONE)
  isFunded         Boolean           @default(false)
  grantTitle       String?
  fundingAgency    String?
  grantAmount      Float?
  grantNumber      String?
  detailsJson      Json? // type-specific metadata
  enteredById      String
  approvedById     String?
  approvedAt       DateTime?
  score            Float?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  enteredBy  User    @relation("PublicationEnteredBy", fields: [enteredById], references: [id])
  approvedBy User?   @relation("PublicationApprovedBy", fields: [approvedById], references: [id])

  @@index([projectId])
  @@index([status])
  @@map("publications")
}

model PublicationScoreConfig {
  id              String          @id @default(cuid())
  publicationType PublicationType
  subType         String
  score           Int

  @@unique([publicationType, subType])
  @@map("publication_score_configs")
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  CANCELLED
}

model DepartmentConfiguration {
  id                String   @id @default(cuid())
  academicYear      String
  department        String
  divisionCount     Int      @default(0)
  studentCount      Int      @default(0)
  projectGroupCount Int      @default(0)
  isActive          Boolean  @default(true)
  configuredByUserId String?
  configuredBy      User?    @relation(fields: [configuredByUserId], references: [id], onDelete: SetNull)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([academicYear, department])
  @@index([department, academicYear])
  @@map("department_configurations")
}

model FacultyGuideInvitation {
  id              String           @id @default(cuid())
  department      String
  email           String
  name            String?
  status          InvitationStatus @default(PENDING)
  invitedByUserId String?
  invitedBy       User?            @relation(fields: [invitedByUserId], references: [id], onDelete: SetNull)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([email])
  @@index([department, status])
  @@index([status])
  @@map("faculty_guide_invitations")
}

model DepartmentGuide {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation("DepartmentGuideMember", fields: [userId], references: [id], onDelete: Cascade)
  department String
  addedById  String?
  addedBy    User?    @relation("DepartmentGuideAddedBy", fields: [addedById], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())

  @@unique([userId, department])
  @@index([department])
  @@map("department_guides")
}
